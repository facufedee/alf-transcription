# Google AI Studio key (https://aistudio.google.com) — backend only, never in the frontend
GEMINI_API_KEY=

# Models (defaults shown). The Live model transcribes; the text model translates.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
# true (default) = manual activity control, cycled every few seconds so transcription
# actually flushes. false = automatic server-side VAD — flushes once after the first
# utterance, then never opens a new turn for continuous real speech. Broken for talks.
GEMINI_LIVE_MANUAL_ACTIVITY=true

PORT=5000
# Origins allowed by CORS, comma-separated
FRONTEND_URL=http://localhost:3000
# Fallback shared token to stream audio, only used when AUTH_SECRET is unset.
# Leave empty only for local dev.
INGEST_TOKEN=
# Must match the frontend's AUTH_SECRET exactly — it verifies the operator JWT
# minted by GET /api/auth/token (frontend) before accepting audio on /ingest.
# Generate: openssl rand -base64 32
AUTH_SECRET=
