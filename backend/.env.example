# Google AI Studio key (https://aistudio.google.com) — backend only, never in the frontend
GEMINI_API_KEY=

# Models (defaults shown). The Live model transcribes; the text model translates.
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
GEMINI_TRANSLATE_MODEL=gemini-2.5-flash-lite
# true = keep the Live session in one open turn so the model only transcribes and never answers
GEMINI_LIVE_MANUAL_ACTIVITY=true

PORT=5000
# Origins allowed by CORS, comma-separated
FRONTEND_URL=http://localhost:3000
# Operators must send this token to stream audio. Leave empty only for local dev.
INGEST_TOKEN=
# Shared with the frontend to sign/verify operator tokens (Phase 4). Generate: openssl rand -base64 32
AUTH_SECRET=
